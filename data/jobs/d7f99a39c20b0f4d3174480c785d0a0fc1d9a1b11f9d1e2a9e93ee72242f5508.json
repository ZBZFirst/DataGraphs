"scalar_key":"worksite","scalar_value":"Jacobs Medical Center","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"certification","requirement_level":"required","item_text":"Active California CNA license.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"certification","requirement_level":"required","item_text":"BART or BLS at time of hire with commitment to get BART within six (6) months of hire date.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"condition_of_employment","requirement_level":null,"item_text":"Must be able to work various hours and locations based on business needs.","source_heading":"SPECIAL CONDITIONS","source_subheading":null},{"item_type":"condition_of_employment","requirement_level":null,"item_text":"Employment is subject to a criminal background check and pre-employment physical.","source_heading":"SPECIAL CONDITIONS","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Previous acute care CNA or other direct patient-care experience.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Under the supervision of the Registered Nurse, the CNA/Clinical Care Partner supports the continuum of care by providing basic patient care and assistance with activities of daily living. Performs uncomplicated technical procedures. Utilizes a variety of technical equipment and supplies. Provides basic patient care support: patient transport, specimen and blood and blood products transport, and inventory management.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Jacobs Medical Center 5FG is a 24 bed Medical Oncology/Palliative Care Progressive Care Unit. Several disciplines collaborate to provide prescribed oncology care including chemotherapy and biotherapy. The unit is also designated as the overflow for Blood and Marrow Transplant patients. The nursing team is dedicated to care for patients who need aggressive symptom management. They work closely with a multi-disciplinary palliative care team, implementing a holistic approach to physical, psychosocial, emotional and spiritual well-being.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"This position requires initiative, the ability to prioritize demands and the ability to work in a team environment. Participates in collaborative team environment, including: training and evaluation of peers; scheduling of work; and assisting the administrative functions of the unit.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"EPIC, UCSD Paging & Scheduling Systems.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Bilingual: Spanish/English.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Demonstrated ability to observe deviations from normal.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Knowledge of medical terminology.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null}],"pay":{"salary_min":26.53,"salary_max":35.03,"salary_period":"hour","annual_min":55182.4,"annual_max":72862.40000000001,"annual_comparison":64022.40000000001,"status":"usable","source":"scalar:hiring_pay_scale","source_heading":"hiring pay scale","source_text":"$26.53 - $35.03 / Hour","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-09-30T16:00:20.432816+00:00"}
