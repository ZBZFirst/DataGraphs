ding":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Under the supervision of the Patient Support Services Supervisors, the Telemetry/Video Monitor Breaker Technician is responsible for remote cardiac monitoring, continuous patient observation, and serving as a resource to provide relief, breaks, and clinical support to staff members on duty.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"The position supports both cardiac monitoring and video patient observation to promote safety and quality care. Key responsibilities include rhythm interpretation, documentation, and timely communication of cardiac variances to clinical staff. The role also involves active video monitoring to prevent falls, self-harm, or equipment removal, with appropriate escalation of safety concerns. Additional support includes troubleshooting telemetry leads, pulse oximetry, and monitoring equipment, replacing batteries, repositioning cameras, and assisting with transitions to VMT. This position plays a critical role in ensuring continuous monitoring, supporting hospital-wide safety initiatives, and maintaining compliance with confidentiality and hospital policies.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Successful completion of a telemetry technician course/and or ECG training course.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Excellent communication and interpersonal skills when interacting with all levels of staff and patients.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null}],"pay":{"salary_min":27.43,"salary_max":36.19,"salary_period":"hour","annual_min":57054.4,"annual_max":75275.2,"annual_comparison":66164.8,"status":"usable","source":"scalar:hiring_pay_scale","source_heading":"hiring pay scale","