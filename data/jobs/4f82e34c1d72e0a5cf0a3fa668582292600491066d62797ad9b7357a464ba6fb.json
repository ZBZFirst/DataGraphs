},{"scalar_key":"salary_min","scalar_value":"147500","source_heading":null,"confidence":"parser"},{"scalar_key":"salary_period","scalar_value":"year","source_heading":null,"confidence":"parser"},{"scalar_key":"schedule_text","scalar_value":"Full-time","source_heading":null,"confidence":"parser"},{"scalar_key":"scheduled_weekly_hours","scalar_value":"40","source_heading":null,"confidence":"parser"},{"scalar_key":"source_job_id_confirmed","scalar_value":"1455379","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_required","scalar_value":"Yes","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_text","scalar_value":"Yes, 15 % of the Time","source_heading":null,"confidence":"parser"},{"scalar_key":"workdays","scalar_value":"Mon, Tue, Wed, Thu, Fri","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_end","scalar_value":"04:00 PM","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_start","scalar_value":"07:00 AM","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"certification","requirement_level":"required","item_text":"Sterile Processing Distribution Technician Certificate required at hire OR Registered Central Service Technician Certificate required at hire","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certified Flexible Endoscope Reprocessor (CFER) OR Certified Endoscope Reprocessor (CER).","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certified Healthcare Leader (CHL) OR Management in Sterile Processing (CSPM).","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"education","requirement_level":"required","item_text":"Bachelors degree in Health Care Administration, Public Health, Health Sciences, Business, or related field AND minimum eight (8) years of experience in sterile processing, health care operations, health care administration, materials management, supply distribution, inventory control, or directly related field OR Minimum eleven (11) years of experience in sterile processing, health care operations, health care administration, materials management, supply distribution, inventory control, or a directly related field.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum two (2) years of experience managing operational or project budgets.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum three (3) years of experience in a leadership role with direct reports.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum six (6) years of experience in sterile processing and/or processing reusable medical/surgical equipment/instruments.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Prepares individuals for growth opportunities and advancement; builds internal collaborative networks for self and others. Solicits and acts on performance feedback; drives collaboration to set goals and provide open feedback and coaching to foster performance improvement. Demonstrates continuous learning; oversees the recruitment, selection, and development of talent; ensures performance management guidelines and expectations to achieve business needs. Stays up to date with organizational best practices, processes, benchmarks, and industry trends; shares best practices within and across teams. Motivates and empowers teams; maintains a highly skilled and engaged workforce by aligning resource plans with business objectives. Provides guidance when difficult decisions need to be made; creates opportunities for expanded scope of decision making and impact.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Oversees the operation of multiple units within a department by identifying member and operational needs; ensures the management of work assignment completion; translates business strategy into actionable business requirements; ensures products and/or services meet member requirements and expectations while aligning with organizational strategies. Gains cross-functional support for business plans and priorities; assumes responsibility for decision making; sets standards, measures progress, and fosters resolution of escalated issues. Communicates goals and objectives; analyzes resources, costs, and forecasts and incorporates them into business plans; prioritizes and distributes resources. Removes obstacles that impact performance; guides performance and develops contingency plans accordingly; ensures teams accomplish business objectives.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Directs sterile processing knowledge development by: coordinating trainings on sterile processing techniques and procedures to ensure staff meet departmental standards; evaluating the efficacy of training and education programs across the service area on sterile processing activities; and providing consultation across the service area for complex issues related to sterile processing services.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Oversees the management of equipment inventory by: establishing standards and best practices for managing inventory levels and ensuring adequate supplies for the service area; being accountable for preventing wasted supplies/resources and reducing costs across the service area; and working with leaders to establish and review budgets for a service area, purchasing and/or approving purchases of additional supplies as needed to maintain inventory.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Drives the sterilization and processing of equipment by: providing leadership and direction to department managers on the safe and efficient collection, decontamination, assembly, sterilization, and disinfection of all instruments and equipment; ensuring consistent policies and procedures are implemented across the service area in the preparation of surgical trays and case carts; defining sterile processing program priorities and objectives to align with broader business strategies; and reviewing audit results to assess gaps between sterile processing performance standards and actual performance, providing guidance on the design of corrective action plans for highly complex or widespread process improvement needs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Drives regulatory compliance by: monitoring and enforcing compliance with regulations and requirements across a service area; directing regular audits for compliance with relevant regulations and policies and reviewing audit results across a service area; guiding the development and implementation of corrective action plans for issues of non-compliance; and serving as a liaison between operations and leadership to address compliance issues.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Ambiguity/Uncertainty Management","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Audits","source_heading":"Knowledge, Skills and Abilities: (Functiona