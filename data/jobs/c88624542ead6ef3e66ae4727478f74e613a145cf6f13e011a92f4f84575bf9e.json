"scalar_key":"travel_text","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"workdays","scalar_value":"Mon, Tue, Wed, Thu, Fri, Sat, Sun,","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_end","scalar_value":"05:00 PM","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_start","scalar_value":"08:30 AM","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"certification","requirement_level":"required","item_text":"Certified Nurse Midwife (California)","source_heading":"Basic Qualifications","source_subheading":"License, Certification, Registration"},{"item_type":"certification","requirement_level":"required","item_text":"Registered Nurse License (California)","source_heading":"Basic Qualifications","source_subheading":"License, Certification, Registration"},{"item_type":"certification","requirement_level":"required","item_text":"National Provider Identifier","source_heading":"Basic Qualifications","source_subheading":"License, Certification, Registration"},{"item_type":"certification","requirement_level":"required","item_text":"Nurse Midwife National Certification from American Midwifery Certification Board","source_heading":"Basic Qualifications","source_subheading":"License, Certification, Registration"},{"item_type":"certification","requirement_level":"required","item_text":"Neonatal Resuscitation Program","source_heading":"Basic Qualifications","source_subheading":"License, Certification, Registration"},{"item_type":"certification","requirement_level":"required","item_text":"If the department elects to hire a new grad CNM, the California Furnishing Number and, if applicable, DEA Registration Number must be obtained within twelve (12) months of hire.","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"},{"item_type":"certification","requirement_level":"required","item_text":"BCLS (ACLS, PALS, if applicable)","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"},{"item_type":"education","requirement_level":"required","item_text":"Graduate of an accredited RN program.","source_heading":"Basic Qualifications","source_subheading":"Education"},{"item_type":"education","requirement_level":"required","item_text":"Graduate of a nurse midwifery program accredited by the A.C.N.M. BS or BSN or BA required, MS Degree required in 2010.","source_heading":"Basic Qualifications","source_subheading":"Education"},{"item_type":"experience","requirement_level":"preferred","item_text":"Three (3) years recent experience as a CNM preferred.","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Under the supervision of an Ob-Gyn physician, manages the care of women during labor and delivery.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Obtains an accurate medical, obstetrical, gynecological and psycho-social history of the present pregnancy.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Observes signs of the members general and obstetrical health status.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Performs complete physical examinations including the pap smear, breast examination, abdominal examination, pelvic examination and clinical pelvimetry.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Records all findings of examinations, histories and significant observations in the patients chart.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Determines pregnancy status during gestation, presentation and position of fetus and fetal heart rate.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Determines whether all findings are within normal limits.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Orders appropriate laboratory examinations such as chest X-ray, ultrasound, CBC, urinalysis, blood type and Rh factor, serology tests.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Consults with and obtains orders from an obstetrician for any special care or diagnostic procedure and refers to other services as necessary.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Institutes preventative measures and detects abnormal conditions, obtains consultation and assistance from physicians as needed.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Teaches, counsels and guides individual members regarding their individual health care.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Determines the need for social services, genetics or mental health services and refers as appropriate.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Evaluates patients general and obstetrical health status.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides health supervision, care and family planning advice to women during antepartum and postpartum periods.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Evaluates fetal status by performing such procedures as abdominal palpation and ultrasound examinations to estimate fetal weight, presentation and position, approximate station and fetal heart rate.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Able to perform internal and external fetal monitoring and interpretation.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Consults with obstetrician regarding questionable findings.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Determines members degree of labor and whether member is to be admitted to labor and delivery.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Independently conducts normal spontaneous vaginal deliveries.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"First assists at Cesarean Sections and gynecological surgeries.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Performs immediate care of the newborn.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Will work 8, 12, or 24hr calls at FMC or OMC (Mon-Sun including Holidays).","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Clinic location is Hesperia. Rounding required.","source_heading":"Preferred Qualifications","source_subheading":null}],"pay":