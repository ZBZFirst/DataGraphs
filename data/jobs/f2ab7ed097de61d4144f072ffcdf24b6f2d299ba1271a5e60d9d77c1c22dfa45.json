onfidence":"parser"},{"scalar_key":"salary_min","scalar_value":"96500","source_heading":null,"confidence":"parser"},{"scalar_key":"salary_period","scalar_value":"year","source_heading":null,"confidence":"parser"},{"scalar_key":"schedule_text","scalar_value":"Full-time","source_heading":null,"confidence":"parser"},{"scalar_key":"scheduled_weekly_hours","scalar_value":"40","source_heading":null,"confidence":"parser"},{"scalar_key":"source_job_id_confirmed","scalar_value":"1447283","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_required","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_text","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"workdays","scalar_value":"Mon, Tue, Wed, Thu, Fri","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_end","scalar_value":"04:00 PM","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_start","scalar_value":"07:00 AM","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"certification","requirement_level":"required","item_text":"Sterile Processing Distribution Technician Certificate required at hire OR Registered Central Service Technician Certificate required at hire","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certified Flexible Endoscope Reprocessor (CFER) OR Certified Endoscope Reprocessor (CER).","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certified Healthcare Leader (CHL) OR Management in Sterile Processing (CSPM).","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"education","requirement_level":"required","item_text":"Bachelors degree in Health Care Administration, Public Health, Health Sciences, Business, or related field AND minimum four (4) years of experience in sterile processing, health care operations, health care administration, materials management, supply distribution, inventory control, or directly related field OR Minimum seven (7) years of experience in sterile processing, health care operations, health care administration, materials management, supply distribution, inventory control, or a directly related field.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum three (3) years of experience in a leadership role with or without direct reports.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum four (4) years of experience in sterile processing and/or processing reusable medical/surgical equipment/instruments.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides developmental opportunities for others; builds collaborative, cross-functional relationships. Solicits and acts on performance feedback; works closely with employees to set goals and provide open feedback and coaching to drive performance improvement. Pursues professional growth; develops and provides training and development to talent for growth opportunities; supports execution of performance management guidelines and expectations. Leads, adapts, implements, and stays up to date with organizational change, challenges, feedback, best practices, processes, and industry trends. Fosters open dialogue amongst team members, engages, motivates, and promotes collaboration within and across teams. Delegates tasks and decisions as appropriate; provides appropriate support, guidance, and scope; encourages development and consideration of options in decision making.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Manages designated work unit or team by translating business plans into tactical action items; oversees the completion of work assignments and identifies opportunities for improvement; ensures all policies and procedures are followed. Aligns team efforts; builds accountability for and measuring progress in achieving results; determines and ensures processes and methodologies are implemented; resolves escalated issues as appropriate; sets standards and measures progress. Fosters the development of work plans to meet business priorities and deadlines; obtains and distributes resources. Removes obstacles that impact performance; identifies and addresses improvement opportunities; guides performance and develops contingency plans accordingly; influences teams to execute in alignment with operational objectives.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Develops teams sterile processing knowledge by: identifying training needs and leading staff trainings on sterile processing techniques and procedures within the department, ensuring staff receive appropriate training; developing and implementing new trainings to further develop team competencies; and serving as a resource for the department or site for sterile processing activities.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Manages equipment inventory by: managing inventory levels to ensure adequate supplies for the department or site, overseeing the maintenance and record keeping of instruments and equipment; identifying opportunities to prevent wasted supplies/resources and reduce costs within the department or a site; and working with leaders to establish and review department budgets, purchasing and/or approving purchases of additional supplies as needed to maintain inventory.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Manages the sterilization and processing of equipment by: delegating tasks across team members and monitoring operations across the department or site to safely and efficiently collect, decontaminate, assemble, sterilize, and disinfect all instruments and equipment; ensuring surgical trays and case carts are prepared with appropriate instruments and equipment and recommending opportunities for optimization/operational efficiency; developing and implementing sterile processing policies and procedures to meet organizational needs; and leading audits to identify gaps between sterile processing performance standards and actual performance, analyzing complex audit results and designing corrective action plans to improve processes.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Ensures regulatory compliance by: overseeing work activities across the department or a site to ensure compliance with applicable regulations and requirements; contributing to regular audits for compliance with relevant regulations and policies, analyzing results of audits to assess compliance; developing solutions and overseeing the resolution of identified problems of non-compliance, ensuring the implementation of corrective action plans; and guiding teams to maintain required regulatory records and reports.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Ambiguity/Uncertainty Management","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Audits","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Attention to Detail","source_heading":"Knowledge