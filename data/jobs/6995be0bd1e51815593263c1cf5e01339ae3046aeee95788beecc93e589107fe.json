heading":null,"confidence":"parser"},{"scalar_key":"total_openings","scalar_value":"2","source_heading":null,"confidence":"parser"},{"scalar_key":"union","scalar_value":"EX Contract","source_heading":null,"confidence":"parser"},{"scalar_key":"worksite","scalar_value":"Other","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"certification","requirement_level":"required","item_text":"BART or BLS at time of hire with commitment to get BART within six (6) months of hire date.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certification in Intravenous Therapy issued by the state of California (LVN IV).","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"Certified Phlebotomy Technician (CPT).","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"certification","requirement_level":"preferred","item_text":"ACLS and/or ART certification.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"condition_of_employment","requirement_level":null,"item_text":"Must be able to work various hours, days, shifts, on-call, and various locations based on business needs.","source_heading":"SPECIAL CONDITIONS","source_subheading":null},{"item_type":"condition_of_employment","requirement_level":null,"item_text":"Employment is subject to a criminal background check and pre-employment physical.","source_heading":"SPECIAL CONDITIONS","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"A minimum of two (2) years of LVN experience.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Express Care or Urgent Care experience.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Demonstrated recent experience in a similar role and setting.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Point of Care testing experience.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Ambulatory experience.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Procedure experience.","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"UC San Diego Health is a Magnet-designated organization, which is a prestigious recognition that applies to only 10% of all U.S. hospitals. Magnet is the “gold standard” for nursing excellence and is based on strengths in five key areas, which include transformational leadership, structural empowerment, exemplary professional practice, new knowledge, innovation and improvements and empirical outcomes. UC San Diego Health has held its Magnet status since 2011.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"The LVN performs a wide variety of patient care activities in support of clinic activity. This includes prioritizing and assisting in patient triage processing, preparation and assistance with patient examinations, administering medications, drawing blood, collecting and preparing laboratory tests, patient education, and venipuncture and IV access. Position requires initiative, the ability to prioritize critical demands, and the ability to work in a team environment.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"This position supports and travels across all Community Care locations, with the majority of time spent at one of the eight Express/Urgent Care locations. While most shifts will be in Express/Urgent Care, the LVN may also be assigned to Community Care’s Primary Care and Specialty Clinics as needed.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Licensed Vocational Nurse (LVN) - issued by the state of California.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Knowledge of universal precautions and proper use of body mechanics.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Ability to take initiative, prioritize critical demands, exercise independent judgement and work in a team environment.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Must possess the skills, knowledge and abilities essential to the successful performance of the duties assigned to the position.","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null}],"pay":{"salary_min":38.09,"salary_max":47.35,"salary_period":"hour","annual_min":79227.20000000001,"annual_max":98488.0,"annual_comparison":88857.6,"status":"usable","source":"scalar:hiring_pay_scale","source_heading":"hiring pay scale","source_text":"$38.09 - $47.35 / Hour","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-09-29T15:32:22.656005+00:00"}
