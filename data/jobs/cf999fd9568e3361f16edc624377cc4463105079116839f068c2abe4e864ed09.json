itional Requirements"},{"item_type":"education","requirement_level":"required","item_text":"Bachelors Degree","source_heading":"Basic Qualifications","source_subheading":"Education"},{"item_type":"education","requirement_level":"required","item_text":"Completion of an accredited Wound, Ostomy, Continence Nursing (WOCN) program.","source_heading":"Basic Qualifications","source_subheading":"Education"},{"item_type":"experience","requirement_level":"required","item_text":"Minimum 1 year previous clinical nursing experience as a Registered Nurse in caring for patients with abdominal stomas, draining wounds, fistulas, and pressure sores ulcers.","source_heading":"Basic Qualifications","source_subheading":"Experience"},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides follow-up and interventions to patients diagnosed with ostomies, draining wounds, fistulae, or skin breakdown secondary to pressure, incontinence, venous hypertension, arterial insufficiency, trauma, surgery or diabetic neuropathy and other related skin issues.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides direct patient care counseling of individuals anticipating surgery which may result in the creation of a stoma, individualized instruction for those who have an abdominal stoma for the diversion of stool or urine, or assessment and treatment recommendations for the above stated skin breakdown conditions. Assists patient through continuum of care for management of related issues. Evaluates new and currently used products for ostomy, continence and wound care. Makes recommendations to patients in obtaining related products.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Assesses individual patient needs and goals, and provides educational programs to physicians, nursing, and other paramedical professionals on ostomy/wound care management and self-care education. Conducts continuing educational programs for physicians and nursing personnel. This helps provide current standards of practice for ostomy patients. Provides patient/family teaching and education regarding ostomy/wound care and self-management.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Fine motor dexterity.","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"},{"item_type":"skill","requirement_level":"required","item_text":"Demonstrated knowledge of pediatric and adult patient teaching principles.","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"},{"item_type":"skill","requirement_level":"required","item_text":"Demonstrated knowledge of the gastrointestinal, genitourinary and integumentary systems including pathophysiology.","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"},{"item_type":"skill","requirement_level":"required","item_text":"Effective communication skills.","source_heading":"Basic Qualifications","source_subheading":"Additional Requirements"}],"pay":{"salary_min":70.33,"salary_max":86.5,"salary_period":"hour","annual_min":146286.4,"annual_max":179920.0,"annual_comparison":163103.2,"status":"usable","source":"normalized_scalars","source_heading":"","source_text":"","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-10-10T16:44:47.090380+00:00"}
