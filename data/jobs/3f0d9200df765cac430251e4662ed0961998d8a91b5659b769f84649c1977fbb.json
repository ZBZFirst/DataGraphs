"},{"scalar_key":"travel_text","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"workdays","scalar_value":"Mon, Tue, Wed, Thu, Fri,","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_end","scalar_value":"05:00 PM","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_start","scalar_value":"08:30 AM","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"education","requirement_level":"required","item_text":"Bachelors degree in Psychology, Counseling, Social Work or a related field AND minimum three (3) years of experience in counseling, social work, or a directly field.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Pursues effective relationships with others by proactively providing resources, information, advice, and expertise with coworkers and members. Listens to, seeks, and addresses performance feedback; provides mentoring to team members. Pursues self-development; creates plans and takes action to capitalize on strengths and develop weaknesses; influences others through technical explanations and examples. Adapts to and learns from change, challenges, and feedback; demonstrates flexibility in approaches to work; helps others adapt to new tasks and processes. Supports and responds to the needs of others to support a business outcome.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Completes work assignments autonomously by applying up-to-date expertise in subject area to generate creative solutions; ensures all procedures and policies are followed; leverages an understanding of data and resources to support projects or initiatives. Collaborates cross-functionally to solve business problems; escalates issues or risks as appropriate; communicates progress and information. Supports, identifies, and monitors priorities, deadlines, and expectations. Identifies, speaks up, and implements ways to address improvement opportunities for team.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides effective client care by leveraging foundational knowledge to provide psychosocial assessment, diagnostic impressions, interventions with individuals/couples/families/groups, and prevention of psychosocial dysfunction/disability/impairment including emotional/mental/behavioral disorders, sharing results with management; collaborating with interdisciplinary teams when conducting psychosocial assessment, including functional status and financial resources to develop an individualized care plan, determine interventions needed, and discuss social service needs; communicating and providing guidance with patients to share results to discuss social work and treatment plans, provide resources, and answer questions; executing social work service plans, applying feedback when appropriate; and participating in the referral of members, patients, and staff to the appropriate services and sharing information with providers.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Coordinates the care of a caseload of patients with low to medium psychosocial acuity by collaborating with the clinical team to disseminate treatment plans to patients and providers; identifying and implementing potential recommendations to improve care coordination; acquiring and applying knowledge of guidelines and protocols to recommend patient referrals; adhering to case management policies and procedures and suggesting improvements to promote member utilization and engagement of services; and ensuring documentation of patient treatment plans and follow-up appointments.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Supports compliant services by learning and complying with organizational, state, and federal guidelines as well as regulatory policies, standards, and procedures, and having awareness of when to escalate compliance-related/regulatory concerns; and maintaining and submitting written and electronic documentation, records, and reports (e.g., charting) according to department, federal, and state regulations, with little to no guidance.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Supports program development and management by helping to evaluate the quality and effectiveness of social work programs and identifying opportunities for new program development; and independently staying up-to-date with industry best practices and new treatment options to recommend and help implement improvements to systems and processes for outcome management as well as social work programs or protocols.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Bilingual (English/Spanish) Level II required.","source_heading":"Minimum Qualifications","source_subheading":"Additional Requirements"},{"item_type":"qualification","requirement_level":"preferred","item_text":"Must successfully pass or have passed the bilingual test (within the last 12 months), or be active in the QBS program.","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Ambiguity/Uncertainty Management","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Accountability","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Attention to Deta