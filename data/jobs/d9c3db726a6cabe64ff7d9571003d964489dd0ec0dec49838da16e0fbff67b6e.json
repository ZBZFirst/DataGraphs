ed.","source_heading":"DESCRIPTION","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Strong interpersonal, organizational, and communication skills","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Familiarity with community resources and social service systems","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Ability to work independently and as part of a multidisciplinary team","source_heading":"MINIMUM QUALIFICATIONS","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Bilingual or multilingual skills relevant to the patient population","source_heading":"PREFERRED QUALIFICATIONS","source_subheading":null}],"pay":{"salary_min":30.21,"salary_max":39.76,"salary_period":"hour","annual_min":62836.8,"annual_max":82700.8,"annual_comparison":72768.8,"status":"usable","source":"scalar:hiring_pay_scale","source_heading":"hiring pay scale","source_text":"$30.21 - $39.76 / Hour","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-10-09T15:56:39.917013+00:00"}
