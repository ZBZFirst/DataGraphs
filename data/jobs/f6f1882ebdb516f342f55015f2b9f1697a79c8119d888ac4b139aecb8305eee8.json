ce_heading":null,"confidence":"parser"},{"scalar_key":"salary_period","scalar_value":"year","source_heading":null,"confidence":"parser"},{"scalar_key":"schedule_text","scalar_value":"Full-time","source_heading":null,"confidence":"parser"},{"scalar_key":"scheduled_weekly_hours","scalar_value":"40","source_heading":null,"confidence":"parser"},{"scalar_key":"source_job_id_confirmed","scalar_value":"1451009","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_required","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"travel_text","scalar_value":"No","source_heading":null,"confidence":"parser"},{"scalar_key":"workdays","scalar_value":"Mon, Tue, Wed, Thu, Fri","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_end","scalar_value":"05:00 PM","source_heading":null,"confidence":"parser"},{"scalar_key":"working_hours_start","scalar_value":"08:00 AM","source_heading":null,"confidence":"parser"}],"items":[{"item_type":"education","requirement_level":"required","item_text":"Bachelors degree in Computer Science, CIS, or related field and Minimum ten (10) years experience in software development or a related field. Additional equivalent work experience may be substituted for the degree requirement.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum six (6) years experience working on project(s) involving the implementation of solutions applying development life cycles (e.g., SDLC).","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Four (4) years of development experience with Node.js","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Four (4) years of development experience with Oracle","source_heading":"Preferred Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Drives the execution of multiple work streams by identifying customer and operational needs; developing and updating new procedures and policies; gaining cross-functional support for objectives and priorities; translating business strategy into actionable business requirements; obtaining and distributing resources; setting standards and measuring progress; removing obstacles that impact performance; guiding performance and developing contingency plans accordingly; solving highly complex issues; and influencing the completion of project tasks by others.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Practices self-leadership and promotes learning in others by soliciting and acting on performance feedback; building collaborative, cross-functional relationships; communicating information and providing advice to drive projects forward; adapting to competing demands and new responsibilities; providing feedback to others, including upward feedback to leadership; influencing, mentoring, and coaching team members; fostering open dialogue amongst team members; evaluating and responding to the strengths and weaknesses of self and unit members; and adapting to and learning from change, difficulties, and feedback.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides insight into recommendations for complex technical solutions that meet design and functional needs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Serves as an expert for innovative technical solutions that meet design and functional needs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Collaborates with architects and/or software consultants to ensure functional specifications are converted into flexible, scalable, and maintainable solution designs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides technical expertise for the development, configuration, or modification of integrated business and/or enterprise application solutions within various computing environments by providing insight, guidance, and an escalation point for the design and coding of component-based applications.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Translates business requirements and functional specifications into physical program designs, code modules, stable application systems, and software solutions by partnering with Business Analysts and other team members to understand business needs and functional specifications.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Leverages networks to drive collaboration between technical teams, architects, and/or software consultants, and ensure functional specifications are converted into flexible, scalable, and maintainable solution designs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Builds and maintains trusting relationships with internal customers, third party vendors, and senior management to ensure the alignment, buy-in, and support of diverse project stakeholders.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Oversees the review and implementation of recommendations of technical solutions across multiple functions.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Takes accountability for ensuring specific interfaces, methods, parameters, procedures, and functions support technical solutions and are aligned with architectural designs.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Derives an overall strategy of data management, within an established Information Architecture, that supports the business model. Identifies information structures and detail to enable the development and secure operation of new information services. Takes overall responsibility for planning effective information storage, sharing, and publishing within the organization.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Sets strategies for effective use of database technology taking account of the complex interrelations between hardware/software. Provides specialist expertise in the development, use, or operation of database management system tools and facilities. Provides expert knowledge in the selection, provision, and use of database architectures, software, and facilities, typically taking responsibility for a team of technical staff.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Facilitates and serves as a technical expert for project teams throughout the release schedule of business and enterprise software solutions.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides expertise and guidance to team members for systems incident responses for complex issues.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Fosters and leverages partnerships with IT teams and vendors to ensure written code adheres to company architectural standards, design patterns, and technical specification.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Maintains and enhances technical expertise and knowledge of industry trends by attending participating conferences, and developing a network with other IT industry experts.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Leads consultation efforts to help ensure new and existing software solutions are developed with insight into industry best practices, strategies, and architectures.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Provides expert technical advice and recommendations to others within the organization on matters related to software engineering, including market trends, and new programs and applications.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Reviews and verifies resource estimates for complex technical design, coding, and testing efforts.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"Identifies specific interfaces, methods, parameters, procedures, and functions, as required, to support technical solutions, serving as an escalation point for complex or unresolved issues related to requirements translation.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"As part of the IT Engineering job family, this position is responsible for leveraging DEVOPS, and both Waterfall and Agile practices, to design, develop, and deliver resilient, secure, multi-channel, high-volume, high-transaction, on/off-premise, cloud-based solutions.","source_heading":"Essential Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Minimum four (4) years in a technical leadership role with or without direct reports.","source_heading":"Minimum Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Ambiguity/Uncertainty Management","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Acts with Compassion","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Attention to Detail","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Analytical Skills","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Business Knowledge","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Application Delivery Process","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Communication","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Application Design, Architecture","source_heading":"Knowledge, Skills and Abilities: (Functional)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Critical Thinking","source_heading":"Knowledge, Skills and Abilities: (Core)","source_subheading":null},{"item_type":"skill","requirement_level":null,"item_text":"Application Maintenance","source_heading"