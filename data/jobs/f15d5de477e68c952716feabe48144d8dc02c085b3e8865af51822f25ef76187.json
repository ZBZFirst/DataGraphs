"item_text":"The Occupational Therapist 2 (Per Diem) functions as a journey-level clinician in vision rehabilitation, responsible for providing high-quality evaluation, treatment planning, therapeutic interventions, and discharge planning for adults with low vision, profound vision loss/blindness, and/or neurological vision impairments on weekdays during normal working hours. Responsibilities include evaluating clients’ abilities to perform activities of daily living (ADLs), conducting home safety/environmental assessments, and providing adaptations to enhance safety, independence, and overall occupational performance. OT interventions will primarily be delivered in home and community settings. Candidates without prior vision experience will receive mentorship and training.","source_heading":"Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Demonstrated initiative and commitment to ongoing clinical learning and growth.","source_heading":"Qualifications","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Post-graduate education in low vision rehabilitation.","source_heading":"Qualifications","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Completion of an accredited program of Occupational Therapy.","source_heading":"Qualifications","source_subheading":null},{"item_type":"qualification","requirement_level":"required","item_text":"Occupational Therapist (OT) - issued by the state of California.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Ability to work independently with minimal supervision.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Strong organizational and time-management skills; ability to prioritize multiple responsibilities.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Positive attitude and strong ability to work collaboratively as part of a multidisciplinary team.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Excellent interpersonal skills; able to communicate effectively with clients, families, team members, and physicians.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Strong verbal and written communication skills.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"required","item_text":"Effective observational, analytical, and teaching skills.","source_heading":"Qualifications","source_subheading":null}],"pay":{"salary_min":74.1,"salary_max":74.1,"salary_period":"hour","annual_min":154128.0,"annual_max":154128.0,"annual_comparison":154128.0,"status":"usable","source":"normalized_scalars","source_heading":"","source_text":"","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-11-03T15:07:51.855397+00:00"}
