 necessary.","source_heading":"Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Microsoft Word and Excel packages","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Strong background in quantitative skills, good hand-eye coordination, good familiarity with","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Ability to handle and perform routine experiments in rodents.","source_heading":"Qualifications","source_subheading":null},{"item_type":"skill","requirement_level":"preferred","item_text":"Molecular and cell biology skills including cell culture, FACS, ELISA, etc.","source_heading":"Qualifications","source_subheading":null}],"pay":{"salary_min":27.25,"salary_max":32.76,"salary_period":"hour","annual_min":56680.0,"annual_max":68140.8,"annual_comparison":62410.4,"status":"usable","source":"normalized_scalars","source_heading":"","source_text":"","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-11-20T17:13:25.748224+00:00"}
