"requirement_level":null,"item_text":"E-Verify","source_heading":"Conditions of Employment","source_subheading":null},{"item_type":"condition_of_employment","requirement_level":null,"item_text":"Pre-Placement Health Evaluation","source_heading":"Conditions of Employment","source_subheading":null},{"item_type":"experience","requirement_level":"required","item_text":"Minimum 5 years of Radiologic Tech experience and 3 years experience as a CT Tech","source_heading":"Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Previous supervisory experience","source_heading":"Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Experience in advanced CT technology (CT 64 or higher)","source_heading":"Qualifications","source_subheading":null},{"item_type":"experience","requirement_level":"preferred","item_text":"Experience in a large teaching facility","source_heading":"Qualifications","source_subheading":null},{"item_type":"job_duty","requirement_level":null,"item_text":"The Supervisor, CT is responsible for providing professional leadership and day-to-day supervision of all computed tomography operations and clinical activities within the assigned facility or facilities, ensuring the safe, efficient, and high-quality delivery of CT imaging services across the continuum of care. The incumbent is accountable for the oversight and coordination of CT scheduling, workflow management, image quality, radiation safety, contrast administration protocols, and equipment performance, ensuring all operations are performed accurately and in alignment with health system standards and all applicable regulatory and accreditation requirements, including The Joint Commission, American College of Radiology, and applicable state and federal regulations. This role assists with the planning, development, implementation, and evaluation of daily CT operations and participates in the development and evaluation of departmental policies and procedures, preparing short and long range goals and objectives for review and approval. The Supervisor provides direct oversight to CT technologist and imaging support coworkers across all assigned functional areas and is responsible for the orientation, training, performance feedback, and professional development of assigned coworkers. This position collaborates with radiologists, clinical leadership, and administrative leadership to support quality improvement initiatives, operational efficiency, dose optimization, and patient satisfaction. The Supervisor exercises independent judgment in managing day-to-day CT operations and the execution of established departmental objectives.","source_heading":"Responsibilities","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"Cert Radiologic Technologist","source_heading":"Qualifications","source_subheading":null},{"item_type":"qualification","requirement_level":"preferred","item_text":"American Registry of Rad Techs","source_heading":"Qualifications","source_subheading":null}],"pay":{"salary_min":58.91,"salary_max":113.89,"salary_period":"hour","annual_min":122532.79999999999,"annual_max":236891.2,"annual_comparison":179712.0,"status":"usable","source":"normalized_scalars","source_heading":"","source_text":"","is_hourly_fte":true,"hours_per_unit":null},"published_at":"2026-11-06T16:14:30.642997+00:00"}
